# Created by .ignore support plugin (hsz.mobi)
.idea/
__pycache__/

# Python tooling
# Virtualenvs, under any name and at any depth. Neither pattern is anchored with a leading slash,
# so both match in every directory -- including the per-task checkouts under .claude/worktrees/,
# which is where the .venv312/ that got committed actually lived. The trailing slash keeps these
# matching directories only, so a file named e.g. venv_notes.md is still tracked.
.venv*/
venv*/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage output (#47). `coverage.json` is the input tools/check_coverage.py reads, regenerated by
# every measured run; committing it would let a stale report satisfy the gate.
.coverage
.coverage.*
coverage.json
htmlcov/

# Metric exports written by the viewer's [e] key (#39). Run output, not source.
exports/

# World snapshots written by the viewer's [s] key (#31). Run output, not source -- and a
# snapshot is the only copy of a world in existence (§3.2), so never one that belongs in git.
saves/
